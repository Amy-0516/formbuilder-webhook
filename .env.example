# Webhook URL Configuration
# Copy this file to .env and edit as needed

# Server port
PORT=3000

# Translation provider: mymemory (default), google-free, auto, deepl, google-cloud, azure
TRANSLATION_PROVIDER=mymemory

# Source language (default: Autodetect)
# SOURCE_LANG=Autodetect

# Target languages (comma-separated)
TARGET_LANGS=en,zh,ja,ko,es,fr,de

# MyMemory email for higher quota (optional, 50000 words/day)
# MYMEMORY_EMAIL=your-email@example.com

# DeepL API key (if using deepl provider)
# DEEPL_API_KEY=your-deepl-key

# Google Cloud Translation API key (if using google-cloud provider)
# GOOGLE_CLOUD_API_KEY=your-google-cloud-key

# Azure Translator key and region (if using azure provider)
# AZURE_TRANSLATOR_KEY=your-azure-key
# AZURE_REGION=global

# Webhook secret for signature verification (optional)
# WEBHOOK_SECRET=your-secret

# Data file path
DATA_FILE=./data/submissions.json

# Max submissions to keep
MAX_SUBMISSIONS=1000
